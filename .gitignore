# ---- vendored native binaries (fetched by scripts/vendor_ffmpeg.py) ----
resources/ffmpeg/
.vendor-tmp/

# ---- build artefacts ----
dist/
*.spec

# A Windows path used as a file name.  On Linux such a name is one file
# whose name contains backslashes, and on Windows the checkout turns it
# into a directory -- which quietly breaks the whole checkout.
\\*


# ---- python ----
__pycache__/
*.py[cod]
*.egg-info/
